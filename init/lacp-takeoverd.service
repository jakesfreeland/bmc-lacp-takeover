[Unit]
Description=BMC LACP takeover
After=systemd-networkd.service
StartLimitIntervalSec=300s
StartLimitBurst=4

[Service]
EnvironmentFile=-/etc/lacp-takeover.conf
ExecStart=/usr/sbin/lacp-takeoverd $LACP_TAKEOVER_ARGS
Restart=always
RestartSec=60s

[Install]
WantedBy=multi-user.target
